{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letsmeet",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  // keep the free *.workers.dev address working even when a custom domain is attached (old links keep working)
  "workers_dev": true,
  // no per-version preview addresses: old versions of the site should not stay reachable
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // the Worker sees every request so it can add security headers to all of them
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "POLLS", "class_name": "Poll" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Poll"] }],
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  // no request logs: nothing about visitors is kept
  "observability": { "enabled": false },
  "vars": {
    // seconds until an undecided plan deletes itself (7 days)
    "POLL_TTL_SECONDS": "604800"
  }
}
