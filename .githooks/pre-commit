#!/bin/sh
# Blocks commits that look like secrets or local data. Enable with: npm run hooks
bad=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)(private|\.wrangler|dist)/|(^|/)\.env$|\.env\.local$|\.dev\.vars$|\.key$|\.pem$|\.p12$|client_secret.*\.json$')
if [ -n "$bad" ]; then
  echo "Refusing to commit files that look like secrets or local data:"
  echo "$bad"
  exit 1
fi
# Google OAuth client secrets (GOCSPX-…), Google API keys, private keys, GitHub tokens, Cloudflare API tokens
if git diff --cached -U0 | grep -E '^\+' | grep -qE '(GOCSPX-[A-Za-z0-9_-]{10,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|CLOUDFLARE_API_TOKEN=[A-Za-z0-9_-]{20,})'; then
  echo "Refusing to commit: the change contains something that looks like a secret key or token."
  exit 1
fi
