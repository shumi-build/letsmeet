# Copy to .env and fill in. .env is git-ignored. Both values end up in the public web page, so neither is a secret.

# OAuth client ID (type: Web application) from your Google Cloud project.
# Its only scope must be https://www.googleapis.com/auth/calendar.freebusy
# Leave empty to run without Google (people can still fill in their days by hand).
VITE_GOOGLE_CLIENT_ID=

# Shown on /privacy as the contact for your copy of the site. Google's OAuth review asks for one.
VITE_CONTACT_EMAIL=
